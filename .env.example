# Copy to .env.local and fill in keys. Never commit real secrets.

# Primary provider: fireworks | deepseek | openai
AI_PROVIDER=fireworks

# Fireworks (OpenAI-compatible)
FIREWORKS_API_KEY=
# Optional overrides:
# AI_BASE_URL=https://api.fireworks.ai/inference/v1
# AI_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Fallback providers (used automatically if primary fails)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
